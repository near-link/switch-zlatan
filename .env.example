# Access Control & Security
WEB_PASSWORD=changeme123

# Cloud Reverse Tunnel Configuration (Optional)
ENABLE_TUNNEL=false
TUNNEL_HOST=my-vps-alias
TUNNEL_DOMAIN=switch.example.com
